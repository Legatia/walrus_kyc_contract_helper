# Sui Configuration
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_PRIVATE_KEY=
SUI_PACKAGE_ID=

# Walrus Configuration
WALRUS_ENDPOINT=https://walrus-testnet-api.example.com
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.example.com
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.example.com

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4

# Security
JWT_SECRET=your_jwt_secret_change_in_production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Storage Limits
MAX_UPLOAD_SIZE_MB=10
MAX_KYC_DOCUMENT_SIZE_MB=5

# Logging
RUST_LOG=info,service=debug,walrus_client=debug

# Optional: PostgreSQL for caching/indexing (if not using Sui objects only)
# DATABASE_URL=postgresql://user:password@localhost/walrus_kyc
